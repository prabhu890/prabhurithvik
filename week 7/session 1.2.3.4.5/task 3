import java.util.*;

class UndergroundSystem {

    static class CheckIn {
        String station;
        int time;

        CheckIn(String station, int time) {
            this.station = station;
            this.time = time;
        }
    }

    static class Route {
        long totalTime;
        int count;
    }

    HashMap<Integer, CheckIn> checkIns = new HashMap<>();
    HashMap<String, Route> routes = new HashMap<>();

    public void checkIn(int id, String stationName, int t) {

        checkIns.put(id, new CheckIn(stationName, t));
    }

    public void checkOut(int id, String stationName, int t) {

        CheckIn in = checkIns.get(id);

        checkIns.remove(id);

        String key = in.station + "-" + stationName;

        if (!routes.containsKey(key)) {
            routes.put(key, new Route());
        }

        Route r = routes.get(key);

        r.totalTime += t - in.time;
        r.count++;
    }

    public double getAverageTime(String startStation,
                                  String endStation) {

        String key = startStation + "-" + endStation;

        Route r = routes.get(key);

        return (double) r.totalTime / r.count;
    }
}
