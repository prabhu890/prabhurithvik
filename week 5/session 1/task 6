public class Main {

    public static void main(String[] args) {

        String s = "AABAAB";

        int deletions = 0;

        for (int i = 1; i < s.length(); i++) {

            if (s.charAt(i) == s.charAt(i - 1)) {
                deletions++;
            }
        }

        System.out.println(deletions);
    }
}
