public class Main {

    public static void main(String[] args) {

        String s = "   -42";

        int i = 0;
        int sign = 1;
        int result = 0;

        while (i < s.length() &&
               s.charAt(i) == ' ') {
            i++;
        }

        if (i < s.length() &&
            (s.charAt(i) == '+' ||
             s.charAt(i) == '-')) {

            if (s.charAt(i) == '-') {
                sign = -1;
            }

            i++;
        }

        while (i < s.length() &&
               Character.isDigit(s.charAt(i))) {

            int digit = s.charAt(i) - '0';

            result = result * 10 + digit;

            i++;
        }

        result = result * sign;

        System.out.println(result);
    }
}
output.-42
